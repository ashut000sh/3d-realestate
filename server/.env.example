# Copy to server/.env  (never commit .env)
PORT=4000
CLIENT_URL=http://localhost:5173
DATABASE_URL=postgres://postgres:postgres@localhost:5432/realestate
JWT_SECRET=change-me-to-a-long-random-string

# Email for OTP codes. Leave SMTP_HOST empty in development:
# the OTP is printed in the server console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
