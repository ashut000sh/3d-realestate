# Copy to server/.env  (never commit .env)
PORT=4000
CLIENT_URL=http://localhost:5173
# This API server's public address (no trailing slash). Share-link previews use it for
# absolute image and page URLs, so on a deployed site it must be the real https:// address.
PUBLIC_SERVER_URL=http://localhost:4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/realestate
JWT_SECRET=change-me-to-a-long-random-string

# Email for OTP codes. Leave SMTP_HOST empty in development:
# the OTP is printed in the server console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Optional: Overpass API servers for "What's nearby", comma-separated, tried in order.
# Leave empty to use the public defaults (overpass-api.de, then the mail.ru mirror).
OVERPASS_URLS=

# Optional: OSRM routing server with a foot profile, for walking routes. Default is the free
# public server below; point it at your own OSRM if you outgrow it.
ROUTING_URL=https://routing.openstreetmap.de/routed-foot
